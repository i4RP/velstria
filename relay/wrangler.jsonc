// VELSTRIA のインターネット対戦用の中継（中身を解釈しない土管）。仕様は README.md。
// 配備: このディレクトリで `npx wrangler deploy`（ログイン済みのアカウントの workers.dev に出る）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velstria-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // 公開 URL は wss://velstria-relay.<アカウントのサブドメイン>.workers.dev。版ごとのプレビュー URL は使わない
  "workers_dev": true,
  "preview_urls": false,
  // 対戦データは保存しない方針なので、Workers Logs（リクエストの記録の保存）も使わない
  "observability": {
    "enabled": false
  },
  // 部屋コード 1 つ = Durable Object 1 つ（idFromName(code)）
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOM",
        "class_name": "RelayRoom"
      },
      // フレンドコード 1 つ = 受信箱 1 つ（idFromName(code)）。招待・フレンド申請の配送用
      {
        "name": "FRIEND_INBOX",
        "class_name": "FriendInbox"
      },
      // フレンドコード 1 つ = ランク 1 つ（idFromName(code)）。アカウントごとのランク戦の記録
      {
        "name": "RANK_ACCOUNT",
        "class_name": "RankAccount"
      },
      // 全体で 1 つ（getByName("global")）。公開の名刺・ランキングの表・運営からのメール
      {
        "name": "DIRECTORY",
        "class_name": "Directory"
      },
      // フレンドコード 1 つ = アカウント 1 つ（idFromName(code)）。クラウド保存・パスワード・Game Center の連携
      {
        "name": "CLOUD_ACCOUNT",
        "class_name": "CloudAccount"
      },
      // Game Center の teamPlayerID 1 つ = 1 つ（getByName("gc:<id>")）。連携したフレンドコードを引く索引
      {
        "name": "GAME_CENTER_INDEX",
        "class_name": "GameCenterIndex"
      }
    ]
  },
  // SQLite バックエンド（無料プランでも使える。保存するのは参加者番号の採番と、受信箱の鍵のハッシュ・最後に繋いだ日時・預かった申請・消した印だけ）
  // 利用停止のフレンドコードは秘密 SUSPENDED_FRIEND_CODES（`wrangler secret put`。ここには書かない）
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["FriendInbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["RankAccount"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["Directory"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["CloudAccount", "GameCenterIndex"]
    }
  ]
}
