  "prompts": {
    "idle": {
      "duration": 4,
      "prompt": "Young demon brawler in a fighting guard, looped idle. Left foot forward, weight on front leg, knees bent. Both fists clenched tight in bladed gauntlets, left fist at chin height forward, right fist lower near jaw, elbows tucked, blades along outer forearms. Chin up. Slow breathing lifts shoulders slightly, small weight shift front to back. Head, chest, shoulders move together. Feet stay planted."
    },
    "walk": {
      "duration": 3,
      "prompt": "Aggressive brawler walking forward in a boxing guard, steady looping steps. Torso leans forward, knees lift high on each step, heel to toe contact. Both fists clenched in bladed gauntlets, held tight near the chin, elbows tucked against ribs so the forearm blades never touch the thighs. Small shoulder sway with each step, eyes forward. Constant walking pace, no stopping."
    },
    "run": {
      "duration": 2,
      "prompt": "Fierce brawler sprinting forward, looping run. Deep forward lean, powerful knee drive, feet strike under the hips. Both fists clenched in bladed gauntlets pumping close to the body, elbows bent 90 degrees, arms swinging front to back and never crossing the thighs. Chest forward, chin up, aggressive. Constant speed, no stopping."
    },
    "combo": {
      "duration": 3,
      "prompt": "Brawler in fighting guard, left foot forward, fists clenched in bladed gauntlets. Small crouch to load, then explosive step in with a sharp left jab: hips and shoulders rotate, arm snaps fully straight, fist knuckles forward. Snap back. Then a powerful right straight punch, back heel pivots, torso twists, right fist fully extended. Absorb recoil in shoulders and return quickly to guard."
    },
    "s1": {
      "duration": 2.5,
      "prompt": "Brawler in fighting guard, fists clenched in bladed gauntlets. Rapid three punch flurry forward: right straight, left straight, right straight, each fully extended at chest height with the torso twisting into every blow and short steps forward. Even rhythm, 0.2 seconds between punches. Recoil in shoulders, then return to tight guard."
    },
    "s2dash": {
      "duration": 2,
      "prompt": "Brawler crouches low and bursts forward in a fast low dash, torso almost horizontal, right fist leading forward at waist height in bladed gauntlet, left fist tucked at the hip. Covers ground explosively, then plants the front foot to stop and rises back to fighting guard."
    },
    "s2leap": {
      "duration": 3,
      "prompt": "Brawler in fighting guard winds up, both fists clenched in bladed gauntlets raised behind the head, then leaps forward in a high arc and lands with a crushing double overhead fist smash into the ground, knees deep bent. On landing throws a quick left hook and a right uppercut. Then recovers to fighting guard."
    },
    "ult": {
      "duration": 3,
      "prompt": "Brawler plants wide stance without stepping, twists torso far back, right fist clenched in bladed gauntlet drawn back to the hip, left arm extended forward aiming, charging power and trembling, feet fixed. Then explodes with a massive right straight punch, full body lunges forward, rear heel pivots, arm fully extended, knuckles forward. Holds briefly and returns to guard."
    }
  },
